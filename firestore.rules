rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alle Besucher werden anonym bei Firebase angemeldet und können dieselbe BMA-Liste lesen/schreiben.
    // Für einen öffentlichen Link ist das einfach, aber nicht für vertrauliche Daten geeignet.
    match /bmaShared/{documentId} {
      allow read, write: if request.auth != null && documentId == 'main';
    }
  }
}
